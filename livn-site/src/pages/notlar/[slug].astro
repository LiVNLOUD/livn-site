---
import NotePage from '../../components/NotePage.astro';
import { getNotes, slugOf } from '../../content-utils';
export async function getStaticPaths() {
  return (await getNotes('tr')).map((note) => ({ params: { slug: slugOf(note.id) }, props: { note } }));
}
const { note } = Astro.props;
---
<NotePage lang="tr" note={note} />
