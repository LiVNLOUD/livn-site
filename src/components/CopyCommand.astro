---
// Kurulum komutu kutusu.
// Komut panoya JavaScript ile YAZILMAZ: "irm … | iex" gibi komutları betikle panoya koymak,
// kötü amaçlı "ClickFix" sitelerinin yöntemidir ve uBlock Origin gibi araçlar bunu haklı olarak engeller.
// Düğme yalnız komutu seçer; kullanıcı Ctrl+C ile kendisi kopyalar.
import { t } from '../i18n';
import type { Lang } from '../site';
interface Props { command: string; note?: string; lang: Lang }
const { command, note, lang } = Astro.props;
const ui = t(lang);
---
<div class="cmd" data-selected={ui.selected}>
  <div class="cmd-row">
    <span class="cmd-prompt" aria-hidden="true">PS&gt;</span>
    <code class="cmd-text" tabindex="0">{command}</code>
    <button type="button" class="cmd-btn">{ui.select}</button>
  </div>
  <p class="cmd-status" role="status" aria-live="polite"></p>
  {note && <p class="cmd-note">{note}</p>}
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('.cmd')) {
    const btn = box.querySelector<HTMLButtonElement>('.cmd-btn');
    const code = box.querySelector<HTMLElement>('.cmd-text');
    const status = box.querySelector<HTMLElement>('.cmd-status');
    if (!btn || !code || !status) continue;
    const select = () => {
      const range = document.createRange();
      range.selectNodeContents(code);
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
      status.textContent = box.dataset.selected ?? '';
    };
    btn.addEventListener('click', () => { select(); code.focus(); });
    code.addEventListener('focus', select);
  }
</script>
