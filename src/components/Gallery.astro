---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { items: { src: ImageMetadata; alt: string }[]; title: string }
const { items, title } = Astro.props;
const full = await Promise.all(items.map((i) => getImage({ src: i.src, width: Math.min(i.src.width, 1920), format: 'webp' })));
---
{items.length > 0 && (
  <section aria-label={title}>
    <h2 class="visually-hidden">{title}</h2>
    <ul class="gallery">
      {items.map((g, i) => (
        <li>
          <figure>
            <a href={full[i].src}>
              <Picture src={g.src} alt={g.alt} widths={[360, 720]} sizes="(min-width: 900px) 33vw, 100vw" formats={['avif', 'webp']} loading="lazy" decoding="async" />
            </a>
            <figcaption>{g.alt}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>
)}
