---
// Ana sayfa: tek sahne. Bir seviye vericisinin sinyali dört katmandan geçer:
// elektrik (4–20 mA) → otomasyon (PLC ham değeri, merdiven) → SCADA (operatör ekranı) → yazılım (OPC UA okuması).
// Ziyaretçi tankı sürükleyerek seviyeyi değiştirir; tüm katmanlar aynı anda güncellenir (src/scripts/home.ts).
import Base from '../layouts/Base.astro';
import { personSchema } from '../lib/schema';
import type { ImageMetadata } from 'astro';
import { SITE, withYears, type Lang } from '../site';
import { PATHS } from '../i18n';
import { getReferences } from '../content-utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const P = PATHS[lang];
const intro = SITE.intro[lang];

const refs = await getReferences(lang);
const countries = new Set(refs.map((r) => r.data.country)).size;
const portrait = Object.values(import.meta.glob<{ default: ImageMetadata }>('../assets/portre.{jpg,jpeg,png,webp}', { eager: true }))[0]?.default;

// Başlangıç seviyesi (betik yoksa da tutarlı görünsün diye tüm değerler bundan hesaplanır)
const L0 = 56;
const HI = 80;
const LO = 20;
const ma0 = (4 + (16 * L0) / 100).toFixed(2);
const raw0 = Math.round((27648 * L0) / 100);
const pv0 = L0.toFixed(1);

const c = {
  tr: {
    title: 'Sahadan koda.',
    lead: 'Sahadaki bir vericinin 4–20 mA sinyali PLC’de sayıya, SCADA’da ekrana, yazılımda veriye dönüşür. {years} yıldır bu hattın her halkasını kuruyorum.',
    hint: 'Değerler simülasyondur. Seviyeyi değiştirmek için tankı sürükleyin.',
    level: 'T-101 tank seviyesi',
    mode: 'Çalışma modu', auto: 'OTO', man: 'MAN',
    layers: [
      { h: 'Elektrik', what: '2 telli 4–20 mA verici' },
      { h: 'Otomasyon', what: 'PLC analog girişi %IW64' },
      { h: 'SCADA', what: 'Operatör ekranında LT-101' },
      { h: 'Yazılım', what: 'OPC UA ile okunan veri' },
    ],
    ok: 'Normal', hi: 'Yüksek seviye alarmı', lo: 'Düşük seviye alarmı',
    proof: `Bu hattı ${SITE.since}’den bu yana ${countries} ülkede ${refs.length} tesiste kurdum.`,
    refs: 'Referansları gör', contact: 'İletişim',
  },
  en: {
    title: 'From field to code.',
    lead: 'A field transmitter’s 4–20 mA signal becomes a number in the PLC, a value on the SCADA screen and data in software. For {years} years I have built every link of that chain.',
    hint: 'Values are simulated. Drag the tank to change the level.',
    level: 'T-101 tank level',
    mode: 'Operating mode', auto: 'AUTO', man: 'MAN',
    layers: [
      { h: 'Electrical', what: '2-wire 4–20 mA transmitter' },
      { h: 'Automation', what: 'PLC analogue input %IW64' },
      { h: 'SCADA', what: 'LT-101 on the operator screen' },
      { h: 'Software', what: 'Data read over OPC UA' },
    ],
    ok: 'Normal', hi: 'High level alarm', lo: 'Low level alarm',
    proof: `Since ${SITE.since} I have built this chain at ${refs.length} plants in ${countries} countries.`,
    refs: 'See references', contact: 'Contact',
  },
}[lang];

// 4–20 mA ölçeği: 200 birimlik çizgi, 10'dan başlar
const maTicks = [4, 8, 12, 16, 20];
---
<Base lang={lang} description={withYears(intro.description)} jsonLd={{ '@graph': [{ '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: SITE.url, name: SITE.name, inLanguage: lang, publisher: { '@id': `${SITE.url}/#person` } }, personSchema(lang, portrait?.src)] }}>
  <section class="stage" aria-labelledby="stage-h" data-stage data-hi={HI} data-lo={LO} data-l-ok={c.ok} data-l-hi={c.hi} data-l-lo={c.lo}>
    <div class="wrap stage-inner">
      <div class="stage-head">
        <h1 id="stage-h">{c.title}</h1>
        <p class="stage-lead">{withYears(c.lead)}</p>
      </div>

      <div class="chain">
        <div class="field">
          <div class="tank-wrap">
            <svg class="tank" viewBox="0 0 140 200" aria-hidden="true">
              <defs><clipPath id="tank-clip"><rect x="12" y="44" width="80" height="148" rx="10" /></clipPath></defs>
              <rect class="tank-body" x="12" y="44" width="80" height="148" rx="10" />
              <g clip-path="url(#tank-clip)"><rect class="tank-fill" x="12" y="44" width="80" height="148" /></g>
              <path class="tank-limit" d={`M12 ${44 + 148 * (1 - HI / 100)}h80M12 ${44 + 148 * (1 - LO / 100)}h80`} />
              <text class="tank-lim-t" x="6" y={44 + 148 * (1 - HI / 100) + 3}>H</text>
              <text class="tank-lim-t" x="6" y={44 + 148 * (1 - LO / 100) + 3}>L</text>
              <text class="tank-tag" x="52" y="34">T-101</text>
              <path class="tank-imp" d="M92 72h24V41" />
              <circle class="tank-tx" cx="116" cy="26" r="15" />
              <text class="tank-tx-t" x="116" y="24">LT</text>
              <text class="tank-tx-t" x="116" y="35">101</text>
            </svg>
            <input class="tank-input" type="range" min="0" max="100" step="0.5" value={L0} aria-label={c.level} aria-valuetext={`${pv0} %`} data-input />
          </div>
          <div class="field-side">
            <div class="mode" role="group" aria-label={c.mode}>
              <button type="button" aria-pressed="true" data-mode="auto">{c.auto}</button>
              <button type="button" aria-pressed="false" data-mode="man">{c.man}</button>
            </div>
            <p class="field-hint">{c.hint}</p>
          </div>
        </div>

        <ol class="layers">
          <li class="wire" aria-hidden="true"><span class="wire-pulse"></span></li>

          <li class="layer">
            <span class="tap" aria-hidden="true"></span>
            <h2>{c.layers[0].h}</h2>
            <p class="layer-what">{c.layers[0].what}</p>
            <p class="readout"><span class="rv" data-out="ma">{ma0}</span><span class="ru">mA</span></p>
            <svg class="viz scale" viewBox="0 0 220 40" aria-hidden="true">
              <path class="scale-base" d="M10 14h200" />
              {maTicks.map((m) => <path class="scale-tick" d={`M${10 + ((m - 4) / 16) * 200} 9v10`} />)}
              {maTicks.map((m) => <text class="scale-t" x={10 + ((m - 4) / 16) * 200} y="34">{m}</text>)}
              <g class="scale-marker"><path d="M10 14l-6-10h12z" /></g>
            </svg>
          </li>

          <li class="layer">
            <span class="tap" aria-hidden="true"></span>
            <h2>{c.layers[1].h}</h2>
            <p class="layer-what">{c.layers[1].what}</p>
            <p class="readout"><span class="rv" data-out="raw">{raw0}</span><span class="ru">/ 27648</span></p>
            <svg class="viz ladder" viewBox="0 0 220 64" aria-hidden="true">
              <path class="rail" d="M3 4v56M217 4v56" />
              <g class="rung" data-rung="hi">
                <path d="M3 20h64M79 20h72M171 20h46" />
                <path class="sym" d="M67 11v18M79 11v18M155 11a12 12 0 0 0 0 18M167 11a12 12 0 0 1 0 18" />
                <text x="73" y="8">PV&gt;{HI}</text><text x="161" y="24">HI</text>
              </g>
              <g class="rung" data-rung="lo">
                <path d="M3 48h64M79 48h72M171 48h46" />
                <path class="sym" d="M67 39v18M79 39v18M155 39a12 12 0 0 0 0 18M167 39a12 12 0 0 1 0 18" />
                <text x="73" y="36">PV&lt;{LO}</text><text x="161" y="52">LO</text>
              </g>
            </svg>
          </li>

          <li class="layer">
            <span class="tap" aria-hidden="true"></span>
            <h2>{c.layers[2].h}</h2>
            <p class="layer-what">{c.layers[2].what}</p>
            <p class="readout"><span class="rv" data-out="pv">{pv0}</span><span class="ru">%</span></p>
            <div class="viz bar" aria-hidden="true"><span class="bar-fill"></span><span class="bar-mark bar-hi"></span><span class="bar-mark bar-lo"></span></div>
            <p class="alarm" data-alarm>{c.ok}</p>
          </li>

          <li class="layer">
            <span class="tap" aria-hidden="true"></span>
            <h2>{c.layers[3].h}</h2>
            <p class="layer-what">{c.layers[3].what}</p>
            <pre class="snippet"><code><span class="c-fn">read</span>(<span class="c-s">"ns=3;s=LT101_PV"</span>)
{'{'}
  value: <span class="c-n" data-out="pv2">{pv0}</span>,
  unit: <span class="c-s">"%"</span>,
  alarm: <span class="c-n" data-out="al">null</span>
{'}'}</code></pre>
          </li>
        </ol>
      </div>

      <div class="stage-foot">
        <p>{c.proof}</p>
        <div class="btns">
          <a class="btn btn-primary" href={P.references}>{c.refs}</a>
          <a class="btn" href={P.about + '#contact'}>{c.contact}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/home';
</script>
