---
// Fotoğrafı olmayan projeler için SCADA "mimik" ekranı tarzında şematik çizim.
// Gerçek tesisin çizimi değildir; sektörün tipik akışını gösterir ve "şematik" olarak etiketlenir.
// Enstrüman etiket numaraları projeye göre değişir (seed), böylece her kapak farklı görünür.
interface Props { sector: string; variant?: string; seed?: string; caption?: string; tag?: string; live?: boolean; status?: [string, string] }
const { sector, variant, seed = '', caption, tag, live = false, status } = Astro.props;
// Sektörün varsayılan çizimi; projede "schematic" alanı varsa o kullanılır
const DEFAULTS: Record<string, string> = { water: 'wastewater', energy: 'power', process: 'nitrate', mining: 'pneumatic', 'oil-gas': 'oil', food: 'feed', software: 'software' };
const v = variant ?? DEFAULTS[sector] ?? 'wastewater';
let h = 0;
for (const c of seed) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const n = (k: number) => String(100 + ((h >>> (k * 3)) % 9) * 100 + k + 1);
