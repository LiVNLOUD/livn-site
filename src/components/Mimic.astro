    <g class="m-inst"><path d="M382 220v-90" /><circle cx="382" cy="112" r="18" /><text x="382" y="109">FT</text><text x="382" y="121">{n(1)}</text></g>
    <g class="m-inst"><path d="M580 216v-36" /><circle cx="580" cy="162" r="18" /><text x="580" y="159">AIT</text><text x="580" y="171">{n(2)}</text></g>
  </g>)}

  {sector === 'energy' && (<g>
    <path class="m-eq" d="M70 300c18-60 18-120 0-180h110c-18 60-18 120 0 180z" />
