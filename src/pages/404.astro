---
import Base from '../layouts/Base.astro';
import { UI } from '../i18n';
---
<Base lang="tr" title={UI.tr.notFoundTitle} description={UI.tr.notFoundText} noindex>
  <section class="wrap nf">
    <p class="code" aria-hidden="true">404</p>
    <h1>{UI.tr.notFoundTitle}</h1>
    <p>{UI.tr.notFoundText}</p>
    <p lang="en">{UI.en.notFoundTitle}. {UI.en.notFoundText}</p>
    <div class="btns">
      <a class="btn btn-primary" href="/">{UI.tr.home}</a>
      <a class="btn" href="/referanslar/">{UI.tr.nav.references}</a>
      <a class="btn" href="/en/" lang="en">English</a>
    </div>
  </section>
</Base>
