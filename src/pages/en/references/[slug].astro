---
import ReferencePage from '../../../components/ReferencePage.astro';
import { getReferences, slugOf } from '../../../content-utils';
export async function getStaticPaths() {
  return (await getReferences('en')).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<ReferencePage lang="en" entry={entry} />
