---
import SoftwarePage from '../../../components/SoftwarePage.astro';
import { getSoftware, slugOf } from '../../../content-utils';
export async function getStaticPaths() {
  return (await getSoftware('en')).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<SoftwarePage lang="en" entry={entry} />
