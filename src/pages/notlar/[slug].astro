---
import NotePage from '../../components/NotePage.astro';
import { getNotes, slugOf } from '../../content-utils';
export async function getStaticPaths() {
  return (await getNotes('tr')).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<NotePage lang="tr" entry={entry} />
